---
import Base from '../layouts/Base.astro';
import Demo from './Demo.astro';
import Fluxo from './Fluxo.astro';
import { type Lang, ui, tr, rotas } from '../data/i18n';
import { type Caso, casos, selos } from '../data/casos';

interface Props {
  lang: Lang;
  caso: Caso;
}
const { lang, caso: c } = Astro.props;
const pt = lang === 'pt';
const i = casos.indexOf(c);
const prev = casos[(i - 1 + casos.length) % casos.length];
const next = casos[(i + 1) % casos.length];
const link = (x: Caso, l: Lang) => rotas.caso(l === 'pt' ? x.slug : x.slugEn, l);
const home = pt ? '/' : '/en/';
const title = `${tr(c.titulo, lang)} — Mateus Ferrão`;
---

<Base lang={lang} title={title} description={tr(c.resumo, lang)} alt={link(c, pt ? 'en' : 'pt')}>
  <article>
    <header class="ch">
      <div class="bg" aria-hidden="true"></div>
      <div class="wrap ch-in">
        <a class="back mono" href={`${home}#casos`}>{tr(ui.voltar, lang)}</a>
        <p class="org mono"><span class="idx">0{i + 1}</span> {tr(c.org, lang)}</p>
        <h1>{tr(c.titulo, lang)}</h1>
        <p class="lead">{tr(c.resumo, lang)}</p>
        <div class="hero-metric">
          <div>
            <span class="mv">{tr(c.numero.valor, lang)}</span>
            <span class="ml">{tr(c.numero.rotulo, lang)}</span>
          </div>
          <span class={`selo selo-${c.numero.selo}`}>{tr(selos[c.numero.selo], lang)}</span>
        </div>
      </div>
    </header>

    <div class="wrap body">
      <div class="cols">
        <section>
          <h2 class="kicker">{tr(ui.problema, lang)}</h2>
          <p class="txt">{tr(c.problema, lang)}</p>
        </section>
        <section>
          <h2 class="kicker">{tr(ui.construi, lang)}</h2>
          <ul class="lista">{c.construi.map((x) => <li>{tr(x, lang)}</li>)}</ul>
        </section>
        <section>
          <h2 class="kicker">{tr(ui.resultado, lang)}</h2>
          <ul class="lista res">{c.resultado.map((x) => <li>{tr(x, lang)}</li>)}</ul>
        </section>
        <aside class="meta">
          {c.prazo && (
            <div>
              <h2 class="kicker">{tr(ui.prazo, lang)}</h2>
              <p class="txt">{tr(c.prazo, lang)}</p>
            </div>
          )}
          {c.ferramentas.length > 0 && (
            <div>
              <h2 class="kicker">{tr(ui.ferramentas, lang)}</h2>
              <ul class="chips">{c.ferramentas.map((f) => <li>{f}</li>)}</ul>
            </div>
          )}
        </aside>
      </div>

      <section class="bloco">
        <div class="bh">
          <h2>{tr(ui.demo, lang)}</h2>
          <p>{pt ? 'Interativa, com dados fictícios. Nada de cliente ou da empresa aparece aqui.' : 'Interactive, with fictitious data. Nothing from clients or the company appears here.'}</p>
        </div>
        <div class="panel pad"><Demo lang={lang} tipo={c.demo} /></div>
      </section>

      <section class="bloco" id="evidencia">
        <div class="bh">
          <h2>{pt ? 'Evidência real' : 'Real evidence'}</h2>
          <p>
            {c.evidencias
              ? pt ? 'Print do sistema em produção, sem dados sensíveis.' : 'Screenshot of the system in production, with no sensitive data.'
              : pt ? 'Por que não há print real aqui.' : 'Why there is no real screenshot here.'}
          </p>
        </div>
        {c.evidencias ? (
          c.evidencias.map((e) => (
            <figure class={`panel ev-fig ${e.estreita ? 'estreita' : ''}`}>
              <span class="ev-tag mono">{pt ? 'Print real · sem dados sensíveis' : 'Real screenshot · no sensitive data'}</span>
              <img src={e.src} width={e.w} height={e.h} alt={tr(e.alt, lang)} loading="lazy" decoding="async" />
              <figcaption>{tr(e.legenda, lang)}</figcaption>
            </figure>
          ))
        ) : (
          <p class="panel ev-nota">
            {pt
              ? 'Sem print real deste caso por confidencialidade: é um sistema interno com dados da empresa ou do cliente. A demo acima usa dados fictícios.'
              : 'No real screenshot for this case, for confidentiality: it is an internal system with company or client data. The demo above uses fictitious data.'}
          </p>
        )}
      </section>

      <section class="bloco">
        <div class="bh">
          <h2>{tr(ui.arquitetura, lang)}</h2>
          <p>{pt ? 'Visão simplificada do fluxo, sem nomes internos.' : 'Simplified view of the flow, without internal names.'}</p>
        </div>
        <div class="panel pad"><Fluxo lang={lang} trilhas={c.arquitetura} /></div>
      </section>

      <nav class="pn" aria-label={pt ? 'Outros casos' : 'Other cases'}>
        <a href={link(prev, lang)}><span class="mono">← {tr(ui.anterior, lang)}</span>{tr(prev.titulo, lang)}</a>
        <a href={link(next, lang)} class="r"><span class="mono">{tr(ui.proximo, lang)} →</span>{tr(next.titulo, lang)}</a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .ch {
    position: relative;
    padding: clamp(36px, 6vw, 72px) 0 clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 70% at 85% 10%, rgba(124, 245, 176, 0.12), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 44px 44px;
    mask-image: linear-gradient(180deg, #000, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000, transparent);
  }
  .ch-in {
    position: relative;
  }
  .back {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .org {
    font-size: 12.5px;
    color: var(--faint);
    margin: 28px 0 10px;
  }
  .idx {
    color: var(--accent);
    margin-right: 6px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 16px;
    max-width: 920px;
  }
  .lead {
    font-size: clamp(17px, 1.8vw, 20px);
    color: var(--muted);
    max-width: 760px;
    margin: 0 0 28px;
  }
  .hero-metric {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-metric div {
    display: grid;
  }
  .mv {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--accent);
  }
  .ml {
    color: var(--muted);
    font-size: 15px;
    margin-top: 6px;
  }
  .hero-metric .selo {
    margin-bottom: 6px;
  }
  .body {
    padding-top: clamp(36px, 6vw, 64px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px) clamp(24px, 5vw, 64px);
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  .cols h2 {
    margin: 0 0 12px;
    font-weight: 500;
  }
  .txt {
    margin: 0;
    font-size: 16.5px;
  }
  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .lista li {
    position: relative;
    padding-left: 22px;
    font-size: 16.5px;
  }
  .lista li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--faint);
  }
  .lista.res li::before {
    content: '✓';
    color: var(--accent);
  }
  .meta {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .bloco {
    margin-top: clamp(40px, 7vw, 80px);
  }
  .bh {
    margin-bottom: 16px;
  }
  .bh h2 {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  .bh p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .pad {
    padding: clamp(14px, 3vw, 28px);
  }
  .ev-fig {
    margin: 0;
    padding: clamp(12px, 2.5vw, 20px);
    display: grid;
    gap: 12px;
  }
  .ev-fig.estreita {
    max-width: 440px;
  }
  .ev-fig img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line-2);
  }
  .ev-tag {
    justify-self: start;
    font-size: 11px;
    color: var(--accent);
    border: 1px solid rgba(124, 245, 176, 0.5);
    padding: 2px 8px;
    border-radius: 6px;
  }
  .ev-fig figcaption {
    color: var(--muted);
    font-size: 14px;
  }
  .ev-nota {
    margin: 0;
    padding: 16px 18px;
    color: var(--muted);
    font-size: 15px;
    border-style: dashed;
  }
  .pn {
    margin-top: clamp(48px, 8vw, 88px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .pn a {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: border-color 0.2s;
  }
  .pn a:hover {
    border-color: rgba(124, 245, 176, 0.45);
  }
  .pn span {
    font-size: 12px;
    color: var(--faint);
    font-weight: 400;
  }
  .pn .r {
    text-align: right;
  }
  @media (max-width: 600px) {
    .pn {
      grid-template-columns: 1fr;
    }
    .pn .r {
      text-align: left;
    }
  }
</style>
