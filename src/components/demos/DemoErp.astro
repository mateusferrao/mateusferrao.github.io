---
import { type Lang } from '../../data/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pt = lang === 'pt';
// Conversas encenadas, com dados fictícios. Os nomes de ferramenta são ilustrativos.
const roteiros = pt
  ? [
      {
        q: 'Quais contas a pagar vencem nesta semana?',
        tool: 'erp.contas_a_pagar(periodo="semana_atual")',
        res: '6 títulos',
        a: 'Vencem 6 títulos nesta semana, R$ 84.310 no total. Os 2 maiores: Fornecedor Exemplo A (R$ 31.200, quinta) e Fornecedor Exemplo B (R$ 22.940, sexta). Quer que eu liste todos?',
      },
      {
        q: 'Quanto já pagamos ao Fornecedor Exemplo A este ano?',
        tool: 'erp.pagamentos(fornecedor="Exemplo A", ano=2026)',
        res: '11 pagamentos',
        a: 'Em 2026 foram 11 pagamentos ao Fornecedor Exemplo A, R$ 287.450 no total. O último foi em 14/10.',
      },
      {
        q: 'Como está a geração das usinas hoje?',
        tool: 'usinas.geracao(data="hoje")',
        res: '4 usinas',
        a: 'Hoje, até agora: 4 usinas gerando, 18,6 MWh no total. A Usina Exemplo 3 está 12% abaixo da média do horário. Quer o gráfico?',
      },
    ]
  : [
      {
        q: 'Which payables are due this week?',
        tool: 'erp.payables(period="this_week")',
        res: '6 items',
        a: '6 payables are due this week, R$ 84,310 in total. The 2 largest: Supplier Example A (R$ 31,200, Thursday) and Supplier Example B (R$ 22,940, Friday). Want the full list?',
      },
      {
        q: 'How much have we paid Supplier Example A this year?',
        tool: 'erp.payments(supplier="Example A", year=2026)',
        res: '11 payments',
        a: 'In 2026 there were 11 payments to Supplier Example A, R$ 287,450 in total. The latest was on Oct 14.',
      },
      {
        q: 'How are the solar plants generating today?',
        tool: 'plants.generation(date="today")',
        res: '4 plants',
        a: 'Today so far: 4 plants generating, 18.6 MWh in total. Example Plant 3 is 12% below its usual output for this hour. Want the chart?',
      },
    ];
---

<div class="demo-erp" data-erp data-roteiros={JSON.stringify(roteiros)}>
  <div class="win">
    <div class="win-top">
      <span class="ava mono" aria-hidden="true">IA</span>
      <div>
        <strong>{pt ? 'Assistente do ERP' : 'ERP assistant'}</strong>
        <small class="mono">{pt ? 'no chat da empresa · via MCP' : 'in company chat · via MCP'}</small>
      </div>
      <span class="demo-tag">{pt ? 'Dados fictícios' : 'Fictitious data'}</span>
    </div>
    <div class="msgs" data-msgs aria-live="polite">
      <p class="hint">{pt ? 'Toque numa pergunta abaixo.' : 'Tap a question below.'}</p>
    </div>
    <div class="sugs" role="group" aria-label={pt ? 'Perguntas de exemplo' : 'Sample questions'}>
      {
        roteiros.map((r, i) => (
          <button type="button" data-i={i}>
            {r.q}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-erp]').forEach((root) => {
    const rs = JSON.parse(root.dataset.roteiros!);
    const box = root.querySelector<HTMLElement>('[data-msgs]')!;
    const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduz ? 0 : ms));
    let ocupado = false;

    // Mantém a pergunta atual no topo da janela: a primeira linha nunca fica cortada.
    let ancora: HTMLElement | null = null;
    // Acompanha a resposta, mas nunca rola a ponto de esconder o início da pergunta.
    const fixar = () => {
      const fim = box.scrollHeight - box.clientHeight;
      box.scrollTop = ancora ? Math.min(fim, ancora.offsetTop - 12) : fim;
    };
    function add(cls: string, txt = '') {
      const el = document.createElement('div');
      el.className = `m ${cls}`;
      el.textContent = txt;
      box.appendChild(el);
      fixar();
      return el;
    }

    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) {
        io.disconnect();
        setTimeout(() => root.querySelector<HTMLButtonElement>('[data-i="0"]')?.click(), 500);
      }
    }, { threshold: 0.5 });
    io.observe(root);

    root.querySelectorAll<HTMLButtonElement>('[data-i]').forEach((b) =>
      b.addEventListener('click', async () => {
        if (ocupado) return;
        ocupado = true;
        box.querySelector('.hint')?.remove();
        const r = rs[Number(b.dataset.i)];
        ancora = add('eu', r.q);
        fixar();
        await wait(450);
        const t = add('tool');
        t.innerHTML = '';
        const n = document.createElement('span');
        n.textContent = '↳ ' + r.tool;
        const s = document.createElement('span');
        s.className = 'st';
        s.textContent = '…';
        t.append(n, s);
        await wait(900);
        s.textContent = '✓ ' + r.res;
        s.classList.add('ok');
        await wait(300);
        const a = add('ia');
        if (reduz) a.textContent = r.a;
        else
          for (const w of r.a.split(' ')) {
            a.textContent += (a.textContent ? ' ' : '') + w;
            fixar();
            await wait(28);
          }
        ocupado = false;
      }),
    );
  });
</script>

<style>
  .win {
    border: 1px solid var(--line-2);
    border-radius: 14px;
    overflow: hidden;
    background: #0c1016;
  }
  .win-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    background: #121821;
  }
  .win-top div {
    display: grid;
    flex: 1;
    line-height: 1.3;
    min-width: 0;
  }
  .win-top strong {
    font-size: 14px;
  }
  .win-top small {
    color: var(--faint);
    font-size: 11px;
  }
  .ava {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #8ab4ff, #7cf5b0);
    color: #061018;
    font-size: 12px;
    font-weight: 700;
  }
  .msgs {
    position: relative;
    height: 300px;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hint {
    margin: auto;
    color: var(--faint);
    font-size: 13px;
  }
  .msgs :global(.m) {
    max-width: 86%;
    font-size: 14px;
    line-height: 1.5;
    padding: 9px 12px;
    border-radius: 12px;
    animation: up 0.25s ease;
  }
  .msgs :global(.eu) {
    align-self: flex-end;
    background: #2b3a55;
  }
  .msgs :global(.ia) {
    align-self: flex-start;
    background: var(--panel-2);
    border: 1px solid var(--line);
  }
  .msgs :global(.tool) {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--info);
    padding: 2px 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .msgs :global(.st) {
    color: var(--faint);
  }
  .msgs :global(.st.ok) {
    color: var(--accent);
  }
  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .sugs {
    display: flex;
    gap: 8px;
    padding: 12px 14px 14px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .sugs button {
    flex: 1 1 auto;
    max-width: 100%;
    white-space: normal;
    font: inherit;
    font-size: 13px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 7px 12px;
    cursor: pointer;
    text-align: left;
  }
  @media (max-width: 560px) {
    .msgs {
      height: 340px;
    }
  }
  .sugs button:hover {
    border-color: var(--accent);
  }
</style>
