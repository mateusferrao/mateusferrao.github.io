---
import { type Lang } from '../../data/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pt = lang === 'pt';
// Mensagens fictícias, inspiradas no formato (não no texto) dos templates reais.
const msgs = pt
  ? {
      m1: 'Oi, Ana! Vi que sua inscrição ficou pela metade. Ficou alguma dúvida? Seu link continua valendo: [link]',
      m24: 'Ana, passando para lembrar: as vagas desta turma estão acabando. Quer ajuda para finalizar? [link]',
      m48: 'Último aviso, Ana: o carrinho expira hoje. Depois disso, só na próxima turma. [link]',
      ok: 'compra aprovada ✓',
      comprou: 'Compra aprovada → Ana saiu da fila. A mensagem de 48h não é enviada.',
      naoComprou: 'Sem compra em 48h → a cadência termina e Ana sai da fila.',
    }
  : {
      m1: 'Hi Ana! Looks like your sign-up was left halfway. Any questions? Your link still works: [link]',
      m24: 'Ana, quick reminder: spots for this cohort are running out. Want help finishing? [link]',
      m48: 'Last call, Ana: your cart expires today. After that, only next cohort. [link]',
      ok: 'purchase approved ✓',
      comprou: 'Purchase approved → Ana left the queue. The 48h message is never sent.',
      naoComprou: 'No purchase in 48h → the cadence ends and Ana leaves the queue.',
    };
---

<div class="demo-rec" data-rec data-msgs={JSON.stringify(msgs)}>
  <div class="head">
    <div class="btns">
      <button type="button" class="btn btn-primary" data-cenario="compra">
        {pt ? '▶ Ana compra depois de 24h' : '▶ Ana buys after 24h'}
      </button>
      <button type="button" class="btn" data-cenario="nada">{pt ? '▶ Ana não compra' : '▶ Ana does not buy'}</button>
    </div>
    <span class="demo-tag">{pt ? 'Lead e mensagens fictícios' : 'Fictitious lead and messages'}</span>
  </div>

  <div class="grid">
    <ol class="linha mono" aria-label={pt ? 'Linha do tempo' : 'Timeline'}>
      <li data-t="0">{pt ? '0h · abandonou o checkout → entra na fila' : '0h · abandoned checkout → joins queue'}</li>
      <li data-t="1">{pt ? '1h · template oficial 1' : '1h · official template 1'}</li>
      <li data-t="24">{pt ? '24h · template oficial 2' : '24h · official template 2'}</li>
      <li data-t="48">{pt ? '48h · template oficial 3' : '48h · official template 3'}</li>
      <li data-t="fim" class="fim"></li>
    </ol>

    <div class="phone" aria-live="polite">
      <div class="phone-top mono">WhatsApp · Academy</div>
      <div class="chat" data-chat>
        <p class="vazio">{pt ? 'Escolha um cenário acima.' : 'Pick a scenario above.'}</p>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rec]').forEach((root) => {
    const msgs = JSON.parse(root.dataset.msgs!);
    const chat = root.querySelector<HTMLElement>('[data-chat]')!;
    const steps = root.querySelectorAll<HTMLElement>('.linha li');
    const fim = root.querySelector<HTMLElement>('.linha .fim')!;
    const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let run = 0;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduz ? 0 : ms));

    function bolha(txt: string, cls = '') {
      const p = document.createElement('p');
      p.className = `msg ${cls}`;
      p.textContent = txt;
      chat.appendChild(p);
      chat.scrollTop = chat.scrollHeight;
    }
    function marca(t: string, cls = 'on') {
      root.querySelector<HTMLElement>(`.linha li[data-t="${t}"]`)?.classList.add(cls);
    }

    async function rodar(cenario: string) {
      const my = ++run;
      chat.innerHTML = '';
      steps.forEach((s) => s.classList.remove('on', 'skip'));
      fim.textContent = '';
      marca('0');
      await wait(500);
      if (my !== run) return;
      marca('1');
      bolha(msgs.m1);
      await wait(1100);
      if (my !== run) return;
      marca('24');
      bolha(msgs.m24);
      await wait(1100);
      if (my !== run) return;
      if (cenario === 'compra') {
        bolha(msgs.ok, 'sys ok');
        marca('48', 'skip');
        fim.textContent = msgs.comprou;
        fim.classList.add('on');
      } else {
        marca('48');
        bolha(msgs.m48);
        await wait(700);
        if (my !== run) return;
        fim.textContent = msgs.naoComprou;
        fim.classList.add('on');
      }
    }
    root.querySelectorAll<HTMLButtonElement>('[data-cenario]').forEach((b) =>
      b.addEventListener('click', () => rodar(b.dataset.cenario!)),
    );
  });
</script>

<style>
  .demo-rec {
    display: grid;
    gap: 18px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .btns .btn {
    font-size: 13.5px;
    padding: 9px 14px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .linha {
    list-style: none;
    margin: 0;
    padding: 0 0 0 18px;
    border-left: 1px dashed var(--line-2);
    display: grid;
    gap: 14px;
    font-size: 12.5px;
    color: var(--faint);
  }
  .linha li {
    position: relative;
    transition: color 0.3s;
  }
  .linha li::before {
    content: '';
    position: absolute;
    left: -23px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-2);
  }
  .linha li:global(.on) {
    color: var(--text);
  }
  .linha li:global(.on)::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .linha li:global(.skip) {
    text-decoration: line-through;
    color: var(--faint);
  }
  .linha .fim:empty {
    display: none;
  }
  .linha .fim {
    color: var(--accent) !important;
  }
  .phone {
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background: #0b141a;
    overflow: hidden;
  }
  .phone-top {
    font-size: 12px;
    padding: 10px 14px;
    background: #1f2c33;
    color: #d1d7db;
  }
  .chat {
    height: 260px;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vazio {
    color: var(--faint);
    font-size: 13px;
    margin: auto;
  }
  .chat :global(.msg) {
    margin: 0;
    max-width: 88%;
    background: #005c4b;
    color: #e9edef;
    padding: 8px 11px;
    border-radius: 10px 10px 2px 10px;
    font-size: 13.5px;
    line-height: 1.45;
    align-self: flex-end;
    animation: pop 0.3s ease;
  }
  .chat :global(.msg.sys) {
    align-self: center;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 99px;
    font-family: var(--mono);
    font-size: 12px;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
</style>
