---
import { type Lang, ui, tr } from '../data/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Replay ILUSTRATIVO com dados fictícios. Não descreve o código real linha a linha.
const linhas =
  lang === 'pt'
    ? [
        { k: 'cmd', t: 'agente-fiscal analisar --quinzena demo' },
        { k: 'tool', t: 'ler_documentos(lote="demo")', r: '6 documentos · PDF e imagem' },
        { k: 'tool', t: 'gemini.multimodal(ler + extrair)', r: 'campos extraídos' },
        { k: 'tool', t: 'montar_analise()', r: 'pronto' },
        { k: 'warn', t: '3 itens para a diretoria olhar' },
        { k: 'item', t: 'Doc 0012 · valor a conferir' },
        { k: 'item', t: 'Doc 0087 · vencimento próximo' },
        { k: 'item', t: 'Doc 0140 · imagem pouco legível' },
        { k: 'ok', t: 'análise entregue à diretoria' },
      ]
    : [
        { k: 'cmd', t: 'tax-agent review --fortnight demo' },
        { k: 'tool', t: 'read_documents(batch="demo")', r: '6 documents · PDF and image' },
        { k: 'tool', t: 'gemini.multimodal(read + extract)', r: 'fields extracted' },
        { k: 'tool', t: 'build_review()', r: 'done' },
        { k: 'warn', t: '3 items for leadership to check' },
        { k: 'item', t: 'Doc 0012 · amount to verify' },
        { k: 'item', t: 'Doc 0087 · due soon' },
        { k: 'item', t: 'Doc 0140 · low-legibility image' },
        { k: 'ok', t: 'review delivered to leadership' },
      ];
const antes = lang === 'pt' ? 'antes' : 'before';
const depois = lang === 'pt' ? 'agora' : 'now';
const rotulo = lang === 'pt' ? 'análise quinzenal da contabilidade' : 'fortnightly accounting review';
---

<figure class="console" data-console>
  <div class="bar" aria-hidden="true">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <span class="title mono">agente · hy-fiscal</span>
    <span class="demo-tag">{tr(ui.demoAviso, lang)}</span>
  </div>
  <div class="screen mono" aria-live="off">
    <ol class="out" data-out></ol>
    <noscript>
      <ol class="out">
        {linhas.map((l) => <li class={`l ${l.k}`}>{l.t}{'r' in l && l.r ? ` ✓ ${l.r}` : ''}</li>)}
      </ol>
    </noscript>
    <div class="result" data-result>
      <div class="res-row">
        <span class="res-k">{antes}</span>
        <span class="track"><span class="fill long"></span></span>
        <span class="res-v">~15h</span>
      </div>
      <div class="res-row">
        <span class="res-k">{depois}</span>
        <span class="track"><span class="fill short"></span></span>
        <span class="res-v accent">~1h</span>
      </div>
      <p class="res-l">{rotulo}</p>
    </div>
  </div>
  <figcaption>
    <span>{tr(ui.consoleLegenda, lang)}</span>
    <button type="button" class="replay mono" data-replay>↻ {tr(ui.replay, lang)}</button>
  </figcaption>
  <script type="application/json" data-lines set:html={JSON.stringify(linhas)} />
</figure>

<script>
  type L = { k: string; t: string; r?: string };
  const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esperar = (ms: number) => new Promise((r) => setTimeout(r, reduz ? 0 : ms));

  function linha(l: L) {
    const li = document.createElement('li');
    li.className = `l ${l.k}`;
    return li;
  }

  async function digitar(el: HTMLElement, txt: string) {
    if (reduz) {
      el.textContent = txt;
      return;
    }
    for (let i = 1; i <= txt.length; i++) {
      el.textContent = txt.slice(0, i);
      await esperar(18 + Math.random() * 30);
    }
  }

  async function rodar(fig: HTMLElement, token: { v: number }, my: number) {
    const out = fig.querySelector<HTMLElement>('[data-out]')!;
    const res = fig.querySelector<HTMLElement>('[data-result]')!;
    const lines: L[] = JSON.parse(fig.querySelector('[data-lines]')!.textContent || '[]');
    out.innerHTML = '';
    res.classList.remove('show');
    for (const l of lines) {
      if (token.v !== my) return;
      const li = linha(l);
      out.appendChild(li);
      if (l.k === 'cmd') {
        const s = document.createElement('span');
        li.appendChild(s);
        await digitar(s, l.t);
        await esperar(350);
      } else if (l.k === 'tool') {
        const nome = document.createElement('span');
        nome.className = 'tname';
        nome.textContent = l.t;
        const st = document.createElement('span');
        st.className = 'st spin';
        st.textContent = '';
        li.append(nome, st);
        await esperar(650 + Math.random() * 450);
        st.className = 'st done';
        st.textContent = `✓ ${l.r ?? ''}`;
        await esperar(180);
      } else {
        li.textContent = l.t;
        await esperar(l.k === 'item' ? 260 : 420);
      }
    }
    if (token.v !== my) return;
    await esperar(250);
    res.classList.add('show');
  }

  document.querySelectorAll<HTMLElement>('[data-console]').forEach((fig) => {
    const token = { v: 0 };
    const start = () => rodar(fig, token, ++token.v);
    fig.querySelector('[data-replay]')?.addEventListener('click', start);
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) {
          io.disconnect();
          start();
        }
      });
      io.observe(fig);
    } else start();
  });
</script>

<style>
  .console {
    margin: 0;
    border-radius: var(--radius);
    border: 1px solid var(--line-2);
    background: radial-gradient(120% 140% at 0% 0%, rgba(124, 245, 176, 0.07), transparent 50%),
      linear-gradient(180deg, #0d1218, #090c10);
    box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.02) inset;
    overflow: hidden;
    min-width: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2a313a;
  }
  .title {
    font-size: 12px;
    color: var(--faint);
    margin-left: 8px;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .screen {
    padding: 18px 18px 20px;
    font-size: 13px;
    line-height: 1.75;
    min-height: 380px;
  }
  .out {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  :global(.console .l) {
    white-space: pre-wrap;
    word-break: break-word;
    animation: fadein 0.25s ease;
  }
  :global(.console .l.cmd)::before {
    content: '$ ';
    color: var(--accent);
  }
  :global(.console .l.cmd) {
    color: var(--text);
    margin-bottom: 6px;
  }
  :global(.console .l.tool) {
    color: var(--info);
  }
  :global(.console .l.tool)::before {
    content: '↳ ';
    color: var(--faint);
  }
  :global(.console .l.tool .st) {
    margin-left: 10px;
    white-space: nowrap;
  }
  :global(.console .st.done) {
    color: var(--accent);
  }
  :global(.console .st.spin)::after {
    content: '⠋';
    color: var(--faint);
    display: inline-block;
    animation: spin 0.8s steps(8) infinite;
  }
  :global(.console .l.warn) {
    color: var(--warn);
    margin-top: 6px;
  }
  :global(.console .l.warn)::before {
    content: '⚠ ';
  }
  :global(.console .l.item) {
    color: var(--muted);
    padding-left: 18px;
  }
  :global(.console .l.item)::before {
    content: '· ';
  }
  :global(.console .l.ok) {
    color: var(--accent);
    margin-top: 6px;
  }
  :global(.console .l.ok)::before {
    content: '✓ ';
  }
  @keyframes fadein {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
  @keyframes spin {
    0% {
      content: '⠋';
    }
    12% {
      content: '⠙';
    }
    25% {
      content: '⠹';
    }
    37% {
      content: '⠸';
    }
    50% {
      content: '⠼';
    }
    62% {
      content: '⠴';
    }
    75% {
      content: '⠦';
    }
    87% {
      content: '⠧';
    }
  }
  .result {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed var(--line-2);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .result:global(.show) {
    opacity: 1;
    transform: none;
  }
  .res-row {
    display: grid;
    grid-template-columns: 52px 1fr 52px;
    align-items: center;
    gap: 12px;
    margin: 6px 0;
  }
  .res-k {
    color: var(--faint);
    font-size: 12px;
  }
  .res-v {
    text-align: right;
    font-weight: 700;
    font-size: 15px;
  }
  .accent {
    color: var(--accent);
  }
  .track {
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 99px;
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: 99px;
    width: 0;
    transition: width 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fill.long {
    background: linear-gradient(90deg, #3a4350, #5b6673);
  }
  .fill.short {
    background: var(--accent);
    box-shadow: 0 0 18px rgba(124, 245, 176, 0.6);
  }
  .result:global(.show) .long {
    width: 100%;
  }
  .result:global(.show) .short {
    width: 6.6%;
  }
  .res-l {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 12px;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--faint);
  }
  .replay {
    background: none;
    border: 1px solid var(--line-2);
    color: var(--muted);
    border-radius: 7px;
    padding: 4px 9px;
    font-size: 11.5px;
    cursor: pointer;
    white-space: nowrap;
  }
  .replay:hover {
    color: var(--text);
    border-color: var(--text);
  }
  @media (max-width: 520px) {
    .screen {
      font-size: 12px;
      padding: 14px;
      min-height: 360px;
    }
  }
</style>
