---
import CasePage from '../../../components/CasePage.astro';
import { casos, type Caso } from '../../../data/casos';

export function getStaticPaths() {
  return casos.map((caso) => ({ params: { slug: caso.slugEn }, props: { caso } }));
}
const { caso } = Astro.props as { caso: Caso };
---

<CasePage lang="en" caso={caso} />
